# Intentionally vulnerable CI secrets for the MecaRobotix lab.
# These values are loaded by Jenkins jobs and echoed into build logs.

GITEA_URL="https://devops-server:3000"
GITEA_API_URL="https://devops-server:3000/api/v1"
GITEA_OWNER="mecarobotix"
GITEA_USER="svc_ci_robot_deploy"
GITEA_PASSWORD="SvcDeploy123!"
GITEA_ADMIN_USER="gitea_admin"
GITEA_ADMIN_PASSWORD="Admin123!"

JENKINS_URL="https://ci-server:8443"
JENKINS_ADMIN_USER="jenkins_admin"
JENKINS_ADMIN_PASSWORD="Admin123!"
JENKINS_API_TOKEN="${JENKINS_API_TOKEN:?JENKINS_API_TOKEN must be provided by the runtime environment}"

DIAGNOSTIC_URL="https://diagnostic-server"

ARTIFACT_REGISTRY_PATH="/ci-artifacts"
ARTIFACT_REGISTRY_URL="https://artifact-registry"

ROBOT_A_API_KEY="MRX-TYPE-A-SHARED-KEY"
ROBOT_B_API_KEY="MRX-TYPE-B-SHARED-KEY"
DEFAULT_ROBOT_HOST="robot-a-01"
