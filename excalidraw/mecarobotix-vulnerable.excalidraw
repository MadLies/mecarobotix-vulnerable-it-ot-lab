    {
      "id": "3lhLinNFSRRFWWwxgwcgP",
      "type": "text",
      "x": 4816.279349935617,
      "y": -2893.5288696207026,
      "width": 1789.6083276534673,
      "height": 486.70488057469964,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 291825262,
      "version": 120,
      "versionNonce": 1060263282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779889949395,
      "link": null,
      "locked": false,
      "text": "The server has the following vulnerabilities: Jenkins with weak credentials.\nJobs executing `sh` commands with unvalidated parameters, allowing an attacker to gain a\nshell on the host.\nA pipeline that interacts with Gitea over HTTP without TLS. (creds in plaintext)\nCredentials and tokens stored in plain text in scripts and environment files.\nJenkins logs revealing sensitive secrets.\nA user named `svc_ci_robot_deploy` was created with excessive permissions over\nrepositories.\nA job capable of communicating with internal robots and the diagnostic server.",
      "fontSize": 43.26265605108441,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The server has the following vulnerabilities: Jenkins with weak credentials.\nJobs executing `sh` commands with unvalidated parameters, allowing an attacker to gain a shell on the host.\nA pipeline that interacts with Gitea over HTTP without TLS. (creds in plaintext)\nCredentials and tokens stored in plain text in scripts and environment files.\nJenkins logs revealing sensitive secrets.\nA user named `svc_ci_robot_deploy` was created with excessive permissions over repositories.\nA job capable of communicating with internal robots and the diagnostic server.",
      "autoResize": false,
      "lineHeight": 1.25
    },
