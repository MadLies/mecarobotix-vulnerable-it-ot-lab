    {
      "id": "mhiutaEpdRkKTLwOWotnv",
      "type": "text",
      "x": 3074.248472137377,
      "y": -5183.07695788537,
      "width": 1235.7330866509835,
      "height": 552.3261344112353,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 1961349870,
      "version": 287,
      "versionNonce": 720077870,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779897986021,
      "link": null,
      "locked": false,
      "text": "This is the company's central LDAP directory.\nIt stores users, groups, and service accounts. It exists,\nbut its use on the network is limited; it could be utilized \nmuch more effectively.\nThe identified vulnerabilities are:\n- Weak credentials (administrator)\n- LDAP is used instead of LDAPS\n- At the account level, there are several shared \naccounts used by multiple users ",
      "fontSize": 49.09565639210983,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is the company's central LDAP directory.\nIt stores users, groups, and service accounts. It exists,\nbut its use on the network is limited; it could be utilized \nmuch more effectively.\nThe identified vulnerabilities are:\n- Weak credentials (administrator)\n- LDAP is used instead of LDAPS\n- At the account level, there are several shared \naccounts used by multiple users ",
      "autoResize": true,
      "lineHeight": 1.25
    },
