    {
      "id": "2YRo-Dsp8DKYdT3eIYICG",
      "type": "text",
      "x": -340.25403065676187,
      "y": -1486.8153880873042,
      "width": 578.4833374023438,
      "height": 175,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
