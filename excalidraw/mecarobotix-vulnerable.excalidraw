    {
      "id": "ZcDV-U_oxEWMnWD7ahmUb",
      "type": "text",
      "x": 2727.8302197414437,
      "y": -183.97057312316224,
      "width": 410.48333740234375,
      "height": 135,
      "angle": 0,
      "strokeColor": "#343a40",
