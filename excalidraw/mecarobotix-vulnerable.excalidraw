      "seed": 498938674,
      "version": 337,
      "versionNonce": 1059841010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779890179231,
      "link": null,
      "locked": false,
      "text": "This is a Git server for\nsource code\nmanagement\n- Main issues: shared\naccounts and weak\nadministrator\ncredentials",
      "fontSize": 53.965120718125725,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a Git server for source code management\n- Main issues: shared accounts and weak administrator credentials",
      "autoResize": false,
      "lineHeight": 1.25
    },
