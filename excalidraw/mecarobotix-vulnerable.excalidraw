      "link": null,
      "locked": false,
      "text": "He is responsible for monitoring Gitea,\nreviewing uploads, \nand, when a new release is available, \npushing it to the artifact registry so it can be\nmade available. ",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "He is responsible for monitoring Gitea, reviewing uploads, \nand, when a new release is available, \npushing it to the artifact registry so it can be made available. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
