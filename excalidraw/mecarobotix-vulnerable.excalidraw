    {
      "id": "tVOz4JcHD7J5NwznonbZl",
      "type": "text",
      "x": 9269.70338375448,
      "y": -7349.920575423599,
      "width": 1476.9508700678325,
      "height": 549.5427093935962,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b21",
      "roundness": null,
      "seed": 932851630,
      "version": 694,
      "versionNonce": 1171783666,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779987339301,
      "link": null,
      "locked": false,
      "text": "represents a poorly secured\ncritical database with weak\ncredentials and sensitive\nsecrets/files stored ",
      "fontSize": 109.90854187871923,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "represents a poorly secured critical database with weak credentials and sensitive secrets/files stored ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "v07ze-MRDE0Ja22oMOHHf",
      "type": "text",
      "x": 9461.14295097331,
      "y": -5590.47962944702,
      "width": 769.224178484332,
      "height": 496.3301891188438,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 349911022,
      "version": 135,
      "versionNonce": 1567839218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779973865042,
      "link": null,
      "locked": false,
      "text": "This server exposes\nsensitive files on a web\nserver that is accessible\nwithout authentication,\nand these files are\nexposed via HTTP",
      "fontSize": 66.17735854917917,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This server exposes sensitive files on a web server that is accessible without authentication, and these files are exposed via HTTP",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "IW5GLGbzKfZKWlToQoXb2",
      "type": "text",
      "x": 7251.669202868952,
      "y": -6413.564077234645,
      "width": 945.7218883625538,
      "height": 442.125059792061,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b25",
      "roundness": null,
      "seed": 1304540082,
      "version": 227,
      "versionNonce": 99410866,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779974052062,
      "link": null,
      "locked": false,
      "text": "This server uses a shared account\nfor all users -> This prevents the\ntracking of user actions\nThe server has anonymous access\nenabled, so any user can log in \nFTP is insecure --> FTPS",
      "fontSize": 58.9500079722748,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This server uses a shared account for all users -> This prevents the tracking of user actions\nThe server has anonymous access enabled, so any user can log in \nFTP is insecure --> FTPS",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "SAj4A6daHIFnRI3iG1S6l",
      "type": "text",
      "x": 5133.798589836226,
      "y": -6498.437898154209,
      "width": 1831.5023145554778,
      "height": 533.6081026207723,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b28",
      "roundness": null,
      "seed": 997404398,
      "version": 395,
      "versionNonce": 869708466,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779974306095,
      "link": null,
      "locked": false,
      "text": "- The server has a single service account for logging in\n- The server performs account validation against the\nLDAP service; however, this doesn't make sense because\nall users must use the same account to log in. This\nshould be customized so that each user has their own\naccount ",
      "fontSize": 71.14774701610297,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The server has a single service account for logging in\n- The server performs account validation against the LDAP service; however, this doesn't make sense because all users must use the same account to log in. This should be customized so that each user has their own account ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "JBT8ZkA8nuhEH00KaX6aE",
      "type": "text",
      "x": 4383.302876159358,
      "y": -5573.596279360817,
      "width": 968.631108797716,
      "height": 116.6270810728056,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b29",
      "roundness": null,
      "seed": 1038845422,
      "version": 21,
      "versionNonce": 1948254638,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779974426370,
      "link": null,
      "locked": false,
      "text": "Validates the account on the LDAP server and\nreturns a response if the account is valid",
      "fontSize": 46.65083242912223,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Validates the account on the LDAP server and returns a response if the account is valid",
      "autoResize": false,
      "lineHeight": 1.25
    },
