      "index": "aPV",
      "roundness": null,
      "seed": 1802957550,
      "version": 184,
      "versionNonce": 1805865714,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779887198469,
      "link": null,
      "locked": false,
      "text": "There are two problems:\n1. Communication is sent over HTTP,\n so the secret is visible in plain text.\n2. Authentication is done using a\n hardcoded token that is the same for all bots.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "LKf4LEoNg1AEwVNaEA9ZF",
      "originalText": "There are two problems:\n1. Communication is sent over HTTP,\n so the secret is visible in plain text.\n2. Authentication is done using a\n hardcoded token that is the same for all bots. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
