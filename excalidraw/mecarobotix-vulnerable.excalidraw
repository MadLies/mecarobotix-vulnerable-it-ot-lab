      "isDeleted": false,
      "boundElements": [],
      "updated": 1779886525872,
      "link": null,
      "locked": false,
      "text": "either on its own from time to time or,\n if the user instructsit to do so,\n sends a request to the server to\n update the firmware",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a627PL-UrfDvINPCdxTud",
      "originalText": "either on its own from time to time or,\n if the user instructsit to do so,\n sends a request to the server to\n update the firmware",
      "autoResize": true,
      "lineHeight": 1.25
    },
