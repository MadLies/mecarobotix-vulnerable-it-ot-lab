    {
      "id": "syni1Wb9aJiJLN3XEai3P",
      "type": "text",
      "x": -279.28057313213435,
      "y": 532.3786524505829,
      "width": 429.79998779296875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
