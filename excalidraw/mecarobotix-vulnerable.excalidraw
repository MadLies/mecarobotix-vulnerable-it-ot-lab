      "updated": 1779892024637,
      "link": null,
      "locked": false,
      "text": "Use scripts to interact with \nbots",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "40N2yKAE6HgRBNiMtGbTw",
      "originalText": "Use scripts to interact with \nbots",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y3MYl8zyRybE1jUDH7PiX",
      "type": "text",
      "x": 9462.083753028659,
      "y": -2478.7948838709854,
      "width": 1107.3588975124283,
      "height": 619.4193244062803,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 1848688366,
      "version": 144,
      "versionNonce": 476609842,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779892322028,
      "link": null,
      "locked": false,
      "text": "This is a server that hosts scripts for maintaining and\ntesting the bots; it has the following vulnerabilities:\n- Scripts and configuration files containing secrets and\ncredentials in plain text.\n- Communication with bots via HTTP\n- Scripts that send tokens and sensitive parameters via\nURL.\n- Vulnerable cron jobs running every hour (a user could\ntake control of them).\n- Insecure permissions on /opt/maintenance (777).\n- Operation logs containing sensitive information.\n",
      "fontSize": 41.29462162708538,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a server that hosts scripts for maintaining and testing the bots; it has the following vulnerabilities:\n- Scripts and configuration files containing secrets and credentials in plain text.\n- Communication with bots via HTTP\n- Scripts that send tokens and sensitive parameters via URL.\n- Vulnerable cron jobs running every hour (a user could take control of them).\n- Insecure permissions on /opt/maintenance (777).\n- Operation logs containing sensitive information.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
