      "text": "backup-log-server",
      "fontSize": 106.12257384451001,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "backup-log-server",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "0M2hldQhY_Bt2-ftwYILz",
      "type": "text",
      "x": 11351.013613927551,
      "y": -6273.332022919187,
      "width": 1622.7870363020068,
      "height": 488.09247973887466,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2F",
      "roundness": null,
      "seed": 2091099246,
      "version": 1053,
      "versionNonce": 1052867438,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779987334604,
      "link": null,
      "locked": false,
      "text": "The server is designed to simulate a failure during the\nbackup process: the company believes it has backups\nand logs, but in the event of an incident, it would be\nunable to recover data because the files are empty,\nand the backup directory also has excessive 777\npermissions.",
      "fontSize": 65.07899729851663,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The server is designed to simulate a failure during the backup process: the company believes it has backups and logs, but in the event of an incident, it would be unable to recover data because the files are empty, and the backup directory also has excessive 777 permissions.",
      "autoResize": false,
      "lineHeight": 1.25
    },
